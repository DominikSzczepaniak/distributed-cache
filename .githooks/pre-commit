#!/usr/bin/env bash
set -euo pipefail

# jump to repo root no matter where commit was invoked
cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] Formatting Go code…"
go fmt ./...

echo "[pre-commit] Staging formatting changes…"
git add -u

echo "[pre-commit] Running go vet…"
go vet ./...

echo "[pre-commit] All done."

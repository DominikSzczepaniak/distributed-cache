#!/usr/bin/env bash
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "[pre-commit] Formatting Go code…"
go fmt ./...

echo "[pre-commit] Staging formatting changes…"
git add -u

echo "[pre-commit] Running go vet…"
go vet ./...

echo "[pre-commit] Running short tests (~15s)…"
# TestKnownBug_* intentionally fail (unfixed persistence bugs); see CI.
go test ./... --short -skip TestKnownBug

echo "[pre-commit] All done."
